# frozen_string_literal: true

require "fileutils"

default_platform(:ios)

PROJECT_ROOT = File.expand_path("..", __dir__)
# Keep archives / DerivedData on the project disk when the system volume is low on space.
BUILD_DIR = File.join(PROJECT_ROOT, "build")

def crown_gym_shared
  {
    project: File.join(PROJECT_ROOT, "CrownDash.xcodeproj"),
    scheme: "CrownDash",
    configuration: "Release",
    export_method: "app-store",
    clean: true,
    xcargs: "DEVELOPMENT_TEAM=4SQJ3AH62S -allowProvisioningUpdates",
    output_directory: BUILD_DIR,
    output_name: "CrownDash",
    build_path: File.join(BUILD_DIR, "Archives"),
    derived_data_path: File.join(PROJECT_ROOT, "DerivedDataFastlane")
  }
end

platform :ios do
  before_all do
    tmp = File.join(PROJECT_ROOT, ".tmp")
    FileUtils.mkdir_p(tmp)
    ENV["TMPDIR"] = tmp
    ENV["TMP"] = tmp
    ENV["TEMP"] = tmp
  end

  desc "Regenerate CrownDash.xcodeproj with XcodeGen (install: brew install xcodegen)"
  lane :generate do
    Dir.chdir(PROJECT_ROOT) { sh("xcodegen generate") }
  end

  desc "Build a Release .ipa for App Store / TestFlight (no upload)"
  lane :build do
    generate
    gym(**crown_gym_shared)
  end

  desc "Create app record on App Store Connect + Identifiers in Developer Portal (produce). Uses API key from .env if set; otherwise FASTLANE_APPLE_ID + FASTLANE_PASSWORD."
  lane :create_asc_app do
    load_asc_api_key_optional

    create_app_online(
      app_identifier: "com.bradleyvirtual.crowndash",
      app_name: ENV["ASC_APP_NAME"] || "Adelynn's Crown Dash",
      sku: ENV["ASC_SKU"] || "bradleyvirtual-crowndash-ios",
      language: ENV["ASC_LANGUAGE"] || "English",
      app_version: ENV["ASC_APP_VERSION"] || "1.0",
      team_id: "4SQJ3AH62S",
      itc_team_id: ENV["FASTLANE_ITC_TEAM_ID"] || "4SQJ3AH62S",
      company_name: ENV["ASC_COMPANY_NAME"] || "Bradley Virtual Solutions, LLC"
    )
  end

  desc "Upload existing build/CrownDash.ipa to TestFlight (no archive — use when boot disk is low on space)"
  lane :upload_ipa do
    ipa_path = File.join(BUILD_DIR, "CrownDash.ipa")
    UI.user_error!("Missing IPA: #{ipa_path}. Run `fastlane build` first (on a disk with free space).") unless File.exist?(ipa_path)

    api_key = load_asc_api_key
    upload_opts = testflight_upload_options(api_key, ipa: ipa_path)
    upload_to_testflight(upload_opts)
  end

  desc "Upload App Store screenshots only (no metadata, no binary)"
  lane :upload_screenshots do
    api_key = load_asc_api_key
    opts = {
      app_identifier: "com.bradleyvirtual.crowndash",
      screenshots_path: File.join(PROJECT_ROOT, "fastlane", "screenshots"),
      skip_metadata: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true
    }

    if api_key
      opts[:api_key] = api_key
    elsif ENV["FASTLANE_APPLE_ID"]
      opts[:username] = ENV["FASTLANE_APPLE_ID"]
      UI.message("Using FASTLANE_APPLE_ID for screenshot upload (set FASTLANE_PASSWORD or use session/Duo as prompted).")
    else
      UI.important("No API key or FASTLANE_APPLE_ID — upload will use an existing App Store Connect session or prompt.")
    end

    deliver(opts)
  end

  desc "Upload App Store metadata only (no screenshots, no binary, no review submission)"
  lane :upload_metadata do
    api_key = load_asc_api_key
    opts = {
      app_identifier: "com.bradleyvirtual.crowndash",
      metadata_path: File.join(PROJECT_ROOT, "fastlane", "metadata"),
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true
    }

    if api_key
      opts[:api_key] = api_key
    elsif ENV["FASTLANE_APPLE_ID"]
      opts[:username] = ENV["FASTLANE_APPLE_ID"]
      UI.message("Using FASTLANE_APPLE_ID for metadata upload.")
    else
      UI.important("No API key or FASTLANE_APPLE_ID - upload will use an existing App Store Connect session or prompt.")
    end

    deliver(opts)
  end

  desc "Build and upload to TestFlight (internal testers)"
  lane :beta do
    generate

    api_key = load_asc_api_key

    if ENV["BUILD_NUMBER"]
      increment_build_number(
        build_number: ENV["BUILD_NUMBER"],
        xcodeproj: File.join(PROJECT_ROOT, "CrownDash.xcodeproj"),
        target: "CrownDash"
      )
    end

    gym(**crown_gym_shared)

    upload_opts = testflight_upload_options(api_key)
    upload_to_testflight(upload_opts)
  end
end

def testflight_upload_options(api_key, ipa: nil)
  opts = {
    skip_waiting_for_build_processing: true,
    distribute_external: false,
    notify_external_testers: false,
    changelog: ENV["TESTFLIGHT_WHAT_TO_TEST"] || "Automated build via fastlane."
  }
  opts[:ipa] = ipa if ipa

  if api_key
    opts[:api_key] = api_key
  elsif ENV["FASTLANE_APPLE_ID"]
    opts[:username] = ENV["FASTLANE_APPLE_ID"]
    UI.message("Using FASTLANE_APPLE_ID for upload (set FASTLANE_PASSWORD or use session/Duo as prompted).")
  else
    UI.important("No API key or FASTLANE_APPLE_ID — upload will use an existing App Store Connect session or prompt (see ios/CrownDash/TESTFLIGHT.md).")
  end

  opts
end

def load_asc_api_key_optional
  return nil if ENV["APPSTORE_CONNECT_KEY_ID"].to_s.empty? || ENV["APPSTORE_CONNECT_ISSUER_ID"].to_s.empty?

  load_asc_api_key
end

def load_asc_api_key
  key_id = ENV["APPSTORE_CONNECT_KEY_ID"]
  issuer_id = ENV["APPSTORE_CONNECT_ISSUER_ID"]
  key_path = ENV["APPSTORE_CONNECT_KEY_PATH"]

  return nil if key_id.to_s.empty? || issuer_id.to_s.empty?

  key_path = File.expand_path(key_path, PROJECT_ROOT) if key_path && !key_path.start_with?("/")
  key_path ||= Dir.glob(File.join(PROJECT_ROOT, "fastlane", "AuthKey_*.p8")).first

  unless key_path && File.exist?(key_path)
    UI.user_error!("API key .p8 missing. Set APPSTORE_CONNECT_KEY_PATH or place AuthKey_XXXX.p8 in fastlane/ (see TESTFLIGHT.md).")
  end

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_path,
    duration: 1200,
    in_house: false
  )
end
